# Frontend (Vite) environment. Copy to .env.local for local overrides.
# VITE_* values end up in the public JS bundle — never put secrets here.

# Base URL the browser uses for API calls. "/api" goes through the Vite dev
# proxy (below). Production uses .env.production (the Heroku API).
VITE_API_URL=/api

# Where the Vite dev server proxies /api to (dev only):
#   http://localhost:4000                                  → local backend (cd backend && npm run dev)
#   https://toogoodtogo-web-cfccb22f0618.herokuapp.com    → deployed API, no local backend needed
VITE_API_PROXY_TARGET=http://localhost:4000

# Market from src/config/markets.ts
VITE_MARKET=RS
