# Frontend (Vite) environment. Copy to .env.local and adjust.

# "mock" = run entirely on bundled demo data (no backend needed)
# "http" = call the Express API
VITE_API_MODE=mock

# Base URL the browser uses for API calls. "/api" goes through the Vite dev
# proxy below; set a full URL (https://api.example.rs/api) for production.
VITE_API_URL=/api

# Where the Vite dev server proxies /api to (dev only).
VITE_API_PROXY_TARGET=http://localhost:4000

# Market from src/config/markets.ts
VITE_MARKET=RS
