# Production build settings (committed — contains no secrets).
# Vercel picks this up automatically on every deploy.
VITE_API_URL=https://toogoodtogo-web-cfccb22f0618.herokuapp.com/api
VITE_MARKET=RS
# VITE_MAPBOX_TOKEN (Mapbox pk.… token) is set in Vercel → Environment Variables and in .env.local
# for local/iOS builds — not here (GitHub push protection blocks it). Without it OpenFreeMap is used.
# Mapbox style: "Basic" template (minimal, light).
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/basic-v9
