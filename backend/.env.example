# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas: Atlas → Database → Connect → Drivers, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zalogaj?retryWrites=true&w=majority
# Local development alternative: mongodb://127.0.0.1:27017/zalogaj
MONGODB_URI=

# auto = use multi-document transactions when the server supports them
# (Atlas / any replica set); on = require them; off = atomic updates + compensation only.
MONGODB_TRANSACTIONS=auto

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Default market (see src/config/markets.ts)
DEFAULT_MARKET=RS

# Login/register attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
