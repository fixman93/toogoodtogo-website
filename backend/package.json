{
  "name": "foodnesi-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Foodnesi food-saving marketplace",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/seed.ts",
    "set-role": "tsx src/scripts/set-role.ts",
    "review:apple": "tsx src/scripts/apple-review-accounts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.10",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
